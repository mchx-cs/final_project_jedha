# VM base de données — copie en .env et reprends EXACTEMENT les mêmes valeurs
# que celles déjà présentes dans le .env de la VM web pour DB_NAME, DB_SUPERUSER,
# DB_SUPERUSER_PASSWORD et DB_PASSWORD. Sinon l'application ne pourra pas se connecter.

DB_NAME=medical_office
DB_SUPERUSER=postgres_admin
DB_SUPERUSER_PASSWORD=
DB_PASSWORD=

# Adresse autorisée à joindre la base : celle du serveur web, et elle seule.
APP_ALLOWED_CIDR=192.168.50.3/32
BOOKING_ALLOWED_CIDR=192.168.60.2/32
BOOKING_DB_PASSWORD=
