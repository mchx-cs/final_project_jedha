# Copie ce fichier en .env et remplis des valeurs fortes.
# .env ne doit JAMAIS être commité (voir .gitignore) ni partagé dans le rapport.

# --- Base de données ---
DB_NAME=medical_office
# Compte superuser utilisé UNIQUEMENT à l'initialisation du conteneur postgres
DB_SUPERUSER=postgres_admin
DB_SUPERUSER_PASSWORD=change_me_super_strong
# Compte applicatif à privilèges limités (créé automatiquement par db/001-init.sh)
DB_USER=app_user
DB_PASSWORD=change_me_app_strong

# --- Application Flask ---
# Génère une valeur forte avec : openssl rand -hex 32
FLASK_SECRET_KEY=change_me_random_64_hex

# --- Comptes du personnel créés par seed.py ---
SEED_ADMIN_USER=dr.martin
SEED_ADMIN_PASSWORD=change_me_strong
SEED_SECRETARY_USER=secretariat
SEED_SECRETARY_PASSWORD=change_me_strong
