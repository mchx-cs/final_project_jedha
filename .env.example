# Portail du personnel (web-medical). Copie ce fichier en .env (chmod 600) et
# remplis des valeurs fortes. .env ne doit JAMAIS être commité (voir .gitignore).

# --- Base de données, sur db-medical ---
DB_HOST=192.168.50.2
DB_NAME=medical_office
# Compte applicatif à privilèges limités, créé par db-vm/001-init.sh :
# même mot de passe que DB_PASSWORD dans le .env de db-medical.
DB_USER=app_user
DB_PASSWORD=change_me_app_strong

# --- Application Flask ---
# Génère une valeur forte avec : openssl rand -hex 32
FLASK_SECRET_KEY=change_me_random_64_hex

# Les mots de passe du personnel ne sont jamais stockés ici : seed.py les
# demande à l'écran (voir le README).
