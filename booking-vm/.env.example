# VM DMZ — prise de rendez-vous publique.
# Copie en .env et renseigne les valeurs. Ce fichier ne doit jamais être commité.

# Clé de signature des formulaires : openssl rand -hex 32
FLASK_SECRET_KEY=

# Base de données, sur la VM interne
DB_HOST=192.168.122.51
DB_NAME=medical_office

# Rôle public : INSERT seul sur la table appointments.
# Le mot de passe doit être celui déclaré en BOOKING_DB_PASSWORD sur la VM base.
DB_USER=booking_user
DB_PASSWORD=
